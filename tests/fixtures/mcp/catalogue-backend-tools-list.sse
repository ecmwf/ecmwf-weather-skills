event: message
data: {"jsonrpc":"2.0","id":2,"result":{"tools":[{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"List the datasets available in the catalogue (id, title, description, family, tags).","inputSchema":{"properties":{},"type":"object","title":"list_datasetsArguments"},"name":"list_datasets","outputSchema":{"type":"object","additionalProperties":true,"title":"list_datasetsDictOutput"}},{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"Describe one dataset: its dataset-specific navigation guidance (follow\n        it), the axis order, and the base selection that identifies it.\n        Call this before navigating a dataset.","inputSchema":{"properties":{"dataset_id":{"title":"Dataset Id","type":"string"}},"required":["dataset_id"],"type":"object","title":"describe_datasetArguments"},"name":"describe_dataset","outputSchema":{"type":"object","additionalProperties":true,"title":"describe_datasetDictOutput"}},{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"Return the axes (MARS keys) of a dataset for the CURRENT selection branch.\n\n        For every axis: label, description, selected values, the number of valid\n        options given the other selections, and either the labelled `options`\n        (selectable axes) or a `summary` with the min..max extent (large axes,\n        e.g. dates: choose a range inside it). `invalid` lists selected values\n        that are not available with the rest of the selection, and\n        `unset_axes` lists axes that still have more than one option.\n\n        `selection` maps MARS keys to a code or list of codes, e.g.\n        {\"stream\": \"clmn\", \"param\": [\"167\"], \"year\": [\"2020\", \"2021\"]}.\n        ","inputSchema":{"properties":{"dataset_id":{"title":"Dataset Id","type":"string"},"selection":{"anyOf":[{"additionalProperties":{"anyOf":[{"type":"string"},{"items":{"type":"string"},"type":"array"}]},"type":"object"},{"type":"null"}],"default":null,"title":"Selection"},"focus_axis":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Focus Axis"}},"required":["dataset_id"],"type":"object","title":"get_axesArguments"},"name":"get_axes","outputSchema":{"type":"object","additionalProperties":true,"title":"get_axesDictOutput"}},{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"Read-only \"what if\" check. Each query is\n        {\"axis\": \"param\", \"under\": {\"stream\": [\"clmn\"]}, \"target\": \"133\"}: it\n        reports whether `target` is a valid option of `axis` if the `under`\n        values replaced the current `selection` (axes after them are cleared),\n        and how many options that axis would have. Probe both sides of a\n        branching choice before committing to it.","inputSchema":{"properties":{"dataset_id":{"title":"Dataset Id","type":"string"},"queries":{"items":{"additionalProperties":true,"type":"object"},"title":"Queries","type":"array"},"selection":{"anyOf":[{"additionalProperties":{"anyOf":[{"type":"string"},{"items":{"type":"string"},"type":"array"}]},"type":"object"},{"type":"null"}],"default":null,"title":"Selection"}},"required":["dataset_id","queries"],"type":"object","title":"probe_availabilityArguments"},"name":"probe_availability","outputSchema":{"type":"object","additionalProperties":true,"title":"probe_availabilityDictOutput"}},{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"Turn a selection into the minimal list of valid MARS requests, plus\n        the DestinE data locations (Polytope endpoints) that can serve them.\n        Single-valued axes are filled in automatically; check `unset_axes`\n        (axes you left open, which the request then spans entirely).","inputSchema":{"properties":{"dataset_id":{"title":"Dataset Id","type":"string"},"selection":{"additionalProperties":{"anyOf":[{"type":"string"},{"items":{"type":"string"},"type":"array"}]},"title":"Selection","type":"object"}},"required":["dataset_id","selection"],"type":"object","title":"build_mars_requestsArguments"},"name":"build_mars_requests","outputSchema":{"type":"object","additionalProperties":true,"title":"build_mars_requestsDictOutput"}},{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"How to obtain DestinE credentials and pass them to this MCP server.","inputSchema":{"properties":{},"type":"object","title":"destine_authentication_helpArguments"},"name":"destine_authentication_help","outputSchema":{"type":"object","additionalProperties":true,"title":"destine_authentication_helpDictOutput"}},{"annotations":{"openWorldHint":true,"readOnlyHint":false},"description":"Retrieve the data for a selection from DestinE Polytope.\n\n        The server rebuilds the MARS requests from the selection and fetches\n        each field from one data location that serves it (data split across\n        locations is fetched from each; replicated data only once), or only\n        from `location` if given. It runs the retrieval and\n        returns one download URL per request, reusable until it expires (GRIB, or CoverageJSON\n        when the request has a `feature`).\n\n        Authentication: preferably the MCP client sends a DestinE token in the\n        `X-DestinE-Token` header (see destine_authentication_help). Only as a\n        last resort pass `destine_token` here — the token then passes through\n        the chat/LLM. Never ask the user for their DestinE password.\n        ","inputSchema":{"properties":{"dataset_id":{"title":"Dataset Id","type":"string"},"selection":{"additionalProperties":{"anyOf":[{"type":"string"},{"items":{"type":"string"},"type":"array"}]},"title":"Selection","type":"object"},"location":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Location"},"destine_token":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Destine Token"}},"required":["dataset_id","selection"],"type":"object","title":"retrieve_dataArguments"},"name":"retrieve_data","outputSchema":{"type":"object","additionalProperties":true,"title":"retrieve_dataDictOutput"}}]}}

