{
  "id": "ek-meteogram",
  "prompt": "Make me a meteogram image for Reading, UK covering the next 3 days using the latest ECMWF forecast. Save it as reading.png.",
  "timeout": 1200,
  "max_budget_usd": 3,
  "expect": [
    {
      "kind": "command",
      "pattern": "skills/(open-data|polytope)/"
    },
    {
      "kind": "command",
      "pattern": "odpoint\\.py|ptpoint\\.py"
    },
    {
      "kind": "command",
      "pattern": "ekplot\\.py.*meteogram"
    },
    {
      "kind": "file",
      "pattern": "reading.png"
    },
    {
      "kind": "final",
      "pattern": "(?i)ECMWF"
    },
    {
      "kind": "command_not",
      "pattern": "(?i)open-meteo|openweathermap|weatherapi\\.com|api\\.met\\.no|tomorrow\\.io"
    }
  ],
  "note": "Either point route is correct: Open Data without credentials, Polytope (hourly, KB) with them."
}
