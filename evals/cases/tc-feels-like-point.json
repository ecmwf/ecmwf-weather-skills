{
  "id": "tc-feels-like-point",
  "prompt": "How hot will it feel in Seville over the next 48 hours? I want the heat index or 'feels like' temperature next to the actual temperature, from ECMWF forecasts.",
  "timeout": 900,
  "max_budget_usd": 3,
  "expect": [
    {
      "kind": "command",
      "pattern": "(odpoint|ptpoint)\\.py.*--indices"
    },
    {
      "kind": "command_not",
      "pattern": "273\\.15|-42\\.379|2\\.04901523|10\\.14333127|0\\.5\\s*\\*\\s*\\(.{0,20}61|17\\.27|243\\.04|17\\.62|243\\.12|6\\.112|6\\.1078|5417\\.753|0\\.5555|13\\.12|0\\.6215|11\\.37|0\\.3965|0\\.33\\s*\\*|0\\.7\\s*\\*\\s*\\w+.{0,40}0\\.2\\s*\\*"
    },
    {
      "kind": "command_not",
      "pattern": "(?i)open-meteo|openweathermap|weatherapi\\.com|api\\.met\\.no|tomorrow\\.io"
    },
    {
      "kind": "final",
      "pattern": "(?i)heat index|feels[ -]like|apparent temperature|humidex"
    },
    {
      "kind": "final",
      "pattern": "\u00b0C|degC"
    },
    {
      "kind": "final",
      "pattern": "(?i)ECMWF"
    }
  ],
  "note": "Either point route is correct (Open Data or Polytope); indices come from thermofeel inside the scripts, never from hand-coded formulas."
}
