{
  "id": "cds-discover",
  "prompt": "Which Copernicus Climate Data Store datasets provide ERA5-Land, and what licence and citation do I need if I publish results from the hourly one?",
  "timeout": 600,
  "max_budget_usd": 2,
  "expect": [
    {
      "kind": "skill",
      "name": "ecmwf-cds-ads"
    },
    {
      "kind": "command",
      "pattern": "cds\\.py\\s+(search|describe)"
    },
    {
      "kind": "final",
      "pattern": "reanalysis-era5-land"
    },
    {
      "kind": "final",
      "pattern": "(?i)CC[- ]BY|licen[cs]e"
    },
    {
      "kind": "final",
      "pattern": "10\\.24381/"
    }
  ]
}
