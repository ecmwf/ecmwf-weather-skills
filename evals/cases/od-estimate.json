{
  "id": "od-estimate",
  "prompt": "How much data would I need to download to get 10 days of ECMWF 2 m temperature and total precipitation from the free open data? Don't download anything, just tell me the size.",
  "timeout": 600,
  "max_budget_usd": 2,
  "expect": [
    {
      "kind": "skill",
      "name": "ecmwf-open-data"
    },
    {
      "kind": "command",
      "pattern": "odcatalog\\.py.*estimate|--estimate-only"
    },
    {
      "kind": "command_not",
      "pattern": "odcatalog\\.py\\s+download|(python3?|uv run)\\s+\\S*odpoint\\.py(?!.*--estimate-only)"
    },
    {
      "kind": "final",
      "pattern": "\\d+(\\.\\d+)?\\s?(MB|GB)"
    }
  ]
}
