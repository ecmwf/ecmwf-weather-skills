#
# Runs the repository gate before pushing. Enable once per clone with `make setup`.
# Bypass in an emergency: SKIP_PREPUSH=1 git push
set -euo pipefail
[ "${SKIP_PREPUSH:-0}" = "1" ] && exit 0
cd "$(git rev-parse --show-toplevel)"
make all
