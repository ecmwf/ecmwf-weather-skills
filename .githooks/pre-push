#!/usr/bin/env bash
# Fast local checks before pushing. Enable once per clone: git config core.hooksPath .githooks
# Bypass in an emergency: SKIP_PREPUSH=1 git push
set -euo pipefail
[ "${SKIP_PREPUSH:-0}" = "1" ] && exit 0
cd "$(git rev-parse --show-toplevel)"
python3 scripts/validate_packaging.py
python3 scripts/check_skills.py
if command -v claude >/dev/null 2>&1; then claude plugin validate . >/dev/null; fi
if command -v uv >/dev/null 2>&1; then uv run --quiet pytest -q -x; fi
